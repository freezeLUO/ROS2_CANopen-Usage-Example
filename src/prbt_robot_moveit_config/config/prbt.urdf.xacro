<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="prbt">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import prbt urdf file -->
    <xacro:include filename="$(find arm_prbt)/urdf/arm_prbt.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="prbt.ros2_control.xacro" />


    <xacro:prbt_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
